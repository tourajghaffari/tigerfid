# No lifecycle scripts at install (born-with item 10, KB new-repo-standard —
# A1, hub Sprint 13 approval, Omid 2026-07-31; adopted via hub Story 243.1.2,
# 2026-10-26): this repo is adopted with NO npm tree at all (the rebuild's
# stack is the design study's to decide), so the guard predates the first
# dependency. DIRECTION: a future dependency's install script is silently
# SKIPPED, not failed — a dep that genuinely needs one will misbehave at
# require time, so revisit this line then, deliberately.
# Explicit `npm run <script>` invocations (build, test, start) still run the
# named script — but its pre/post hooks ARE skipped too; fold any check into
# the script itself.
ignore-scripts=true
